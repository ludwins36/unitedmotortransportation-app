# Número de WhatsApp para el botón "Contactar por WhatsApp" en el detalle del vehículo.
# Solo se muestra cuando el vehículo está Aprobado o En tránsito.
# Formato: código de país + número, solo dígitos (ej: 50412345678 para Honduras).
# Copia este archivo a .env y asigna el valor real.
EXPO_PUBLIC_WHATSAPP_NUMBER=14109203660
